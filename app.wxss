page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  color: #333;
  font-size: 28rpx;
  line-height: 1.6;
}

.container {
  padding: 20rpx 30rpx;
}

/* Common card style */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* Section title */
.section-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 24rpx;
}

/* Tag style */
.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  margin-right: 12rpx;
}

.tag-neuro {
  background: #e8f5e9;
  color: #2e7d32;
}

.tag-cognitive {
  background: #e3f2fd;
  color: #1565c0;
}

.tag-imaging {
  background: #fce4ec;
  color: #c62828;
}

.tag-computational {
  background: #fff3e0;
  color: #e65100;
}

.tag-clinical {
  background: #f3e5f5;
  color: #6a1b9a;
}

/* Loading */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 60rpx 0;
}

.loading-text {
  color: #999;
  font-size: 26rpx;
}

/* Empty state */
.empty-state {
  text-align: center;
  padding: 100rpx 0;
}

.empty-state .empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-state .empty-text {
  color: #999;
  font-size: 28rpx;
}
