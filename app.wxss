page {
  background-color: #F0F7F2;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'SF Pro Display', 'Helvetica Neue', Arial, sans-serif;
  color: #2C3E2D;
  font-size: 28rpx;
  line-height: 1.6;
}

.container {
  padding: 24rpx 32rpx;
}

/* Common card style - rounded, soft shadow, playful */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(45, 154, 93, 0.08);
}

/* Section title - bold and green */
.section-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #1A3C2A;
  margin-bottom: 24rpx;
}

/* Tag style - pill shape */
.tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 600;
  margin-right: 12rpx;
}

.tag-neuro {
  background: #E8F5E9;
  color: #2D9A5D;
}

.tag-cognitive {
  background: #FFF8E1;
  color: #F5A623;
}

.tag-imaging {
  background: #E3F2FD;
  color: #2196F3;
}

.tag-computational {
  background: #FFF3E0;
  color: #FF7043;
}

.tag-clinical {
  background: #FCE4EC;
  color: #E91E63;
}

/* Loading */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 80rpx 0;
}

.loading-text {
  color: #8CAF96;
  font-size: 28rpx;
  font-weight: 600;
}

/* Empty state */
.empty-state {
  text-align: center;
  padding: 120rpx 0;
}

.empty-state .empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-state .empty-text {
  color: #8CAF96;
  font-size: 28rpx;
  font-weight: 500;
}
