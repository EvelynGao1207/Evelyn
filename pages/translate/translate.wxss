.header {
  padding: 30rpx 0 20rpx;
}

.header-title {
  font-size: 48rpx;
  font-weight: 800;
  color: #1a1a2e;
}

.header-subtitle {
  font-size: 26rpx;
  color: #666;
  margin-top: 8rpx;
}

/* Language selector */
.lang-selector {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.lang-item {
  flex: 1;
}

.lang-picker {
  background: #fff;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  border: 1rpx solid #e0e0e0;
}

.lang-swap {
  font-size: 36rpx;
  color: #6c5ce7;
  font-weight: 700;
  padding: 10rpx;
}

/* Input area */
.translate-input-area {
  padding: 24rpx;
}

.translate-input {
  width: 100%;
  min-height: 180rpx;
  font-size: 30rpx;
  line-height: 1.8;
  color: #333;
}

.input-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.char-count {
  font-size: 22rpx;
  color: #ccc;
}

.clear-btn {
  font-size: 24rpx;
  color: #f44336;
}

/* Translate button */
.translate-action {
  margin: 24rpx 0;
}

.translate-main-btn {
  background: linear-gradient(135deg, #6c5ce7, #a29bfe);
  color: #fff;
  text-align: center;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.translate-main-btn.disabled {
  opacity: 0.6;
}

/* Result area */
.translate-result-area {
  padding: 24rpx;
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.result-label {
  font-size: 26rpx;
  color: #6c5ce7;
  font-weight: 600;
}

.copy-btn {
  font-size: 24rpx;
  color: #6c5ce7;
  padding: 8rpx 20rpx;
  border: 1rpx solid #6c5ce7;
  border-radius: 20rpx;
}

.result-text {
  font-size: 30rpx;
  color: #333;
  line-height: 2;
}

/* Term highlights */
.term-highlights {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.term-highlight-title {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.term-highlight-item {
  font-size: 26rpx;
  margin-bottom: 8rpx;
}

.th-original {
  color: #6c5ce7;
  font-weight: 600;
}

.th-arrow {
  color: #ccc;
}

.th-translated {
  color: #333;
}

/* Quick phrases */
.quick-phrases {
  margin-top: 30rpx;
}

.phrase-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.phrase-item {
  width: calc(50% - 8rpx);
  padding: 20rpx;
  box-sizing: border-box;
}

.phrase-en {
  font-size: 24rpx;
  color: #6c5ce7;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.phrase-zh {
  font-size: 26rpx;
  color: #333;
}

/* History */
.recent-section {
  margin-top: 40rpx;
}

.history-item {
  padding: 20rpx;
}

.history-original {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-translated {
  font-size: 26rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
