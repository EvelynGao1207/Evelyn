/* Header */
.header {
  padding: 20rpx 0 24rpx;
}

.header-title {
  font-size: 52rpx;
  font-weight: 900;
  color: #1A3C2A;
}

.header-subtitle {
  font-size: 26rpx;
  color: #6B8F7B;
  margin-top: 8rpx;
  font-weight: 500;
}

/* Language selector - green pill style */
.lang-selector {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 28rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(45, 154, 93, 0.08);
}

.lang-item {
  flex: 1;
}

.lang-picker {
  background: #F0F7F2;
  padding: 18rpx 24rpx;
  border-radius: 20rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #1A3C2A;
}

.lang-swap {
  font-size: 36rpx;
  color: #2D9A5D;
  font-weight: 800;
  width: 64rpx;
  height: 64rpx;
  background: #E8F5E9;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* Input area */
.translate-input-area {
  padding: 28rpx;
  border: 2rpx solid #D4E8DA;
}

.translate-input {
  width: 100%;
  min-height: 180rpx;
  font-size: 30rpx;
  line-height: 1.8;
  color: #2C3E2D;
}

.input-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #F0F7F2;
}

.char-count {
  font-size: 22rpx;
  color: #A0C4AD;
  font-weight: 500;
}

.clear-btn {
  font-size: 24rpx;
  color: #E74C3C;
  font-weight: 600;
}

/* Translate button - bold green */
.translate-action {
  margin: 28rpx 0;
}

.translate-main-btn {
  background: #2D9A5D;
  color: #fff;
  text-align: center;
  padding: 28rpx;
  border-radius: 24rpx;
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  box-shadow: 0 6rpx 24rpx rgba(45, 154, 93, 0.3);
}

.translate-main-btn.disabled {
  opacity: 0.6;
}

/* Result area */
.translate-result-area {
  padding: 28rpx;
  border-left: 6rpx solid #2D9A5D;
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.result-label {
  font-size: 26rpx;
  color: #2D9A5D;
  font-weight: 700;
}

.copy-btn {
  font-size: 24rpx;
  color: #fff;
  background: #2D9A5D;
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  font-weight: 600;
}

.result-text {
  font-size: 30rpx;
  color: #1A3C2A;
  line-height: 2;
}

/* Term highlights */
.term-highlights {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #F0F7F2;
}

.term-highlight-title {
  font-size: 24rpx;
  color: #A0C4AD;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.term-highlight-item {
  font-size: 26rpx;
  margin-bottom: 10rpx;
  padding: 8rpx 16rpx;
  background: #F0F7F2;
  border-radius: 12rpx;
}

.th-original {
  color: #2D9A5D;
  font-weight: 700;
}

.th-arrow {
  color: #A0C4AD;
}

.th-translated {
  color: #1A3C2A;
  font-weight: 600;
}

/* Quick phrases - green pill grid */
.quick-phrases {
  margin-top: 32rpx;
}

.phrase-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.phrase-item {
  width: calc(50% - 8rpx);
  padding: 24rpx;
  box-sizing: border-box;
  border: 2rpx solid #D4E8DA;
}

.phrase-en {
  font-size: 24rpx;
  color: #2D9A5D;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.phrase-zh {
  font-size: 26rpx;
  color: #1A3C2A;
  font-weight: 600;
}

/* History */
.recent-section {
  margin-top: 40rpx;
}

.history-item {
  padding: 24rpx;
  border-left: 4rpx solid #A0C4AD;
}

.history-original {
  font-size: 26rpx;
  color: #6B8F7B;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 500;
}

.history-translated {
  font-size: 26rpx;
  color: #1A3C2A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 600;
}
