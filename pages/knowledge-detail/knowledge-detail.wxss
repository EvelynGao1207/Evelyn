/* Meta bar */
.detail-meta-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.difficulty-badge {
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.difficulty-badge.beginner {
  background: #E8F5E9;
  color: #2D9A5D;
}

.difficulty-badge.intermediate {
  background: #FFF8E1;
  color: #F5A623;
}

.difficulty-badge.advanced {
  background: #FCE4EC;
  color: #E74C3C;
}

.reading-time {
  font-size: 24rpx;
  color: #A0C4AD;
  font-weight: 600;
}

.detail-title {
  font-size: 42rpx;
  font-weight: 900;
  color: #1A3C2A;
  line-height: 1.4;
  margin-bottom: 32rpx;
}

/* Table of contents - green card */
.toc {
  background: #F0F7F2;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 40rpx;
  border-left: 6rpx solid #2D9A5D;
}

.toc-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #2D9A5D;
  margin-bottom: 16rpx;
}

.toc-item {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}

.toc-number {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #2D9A5D;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.toc-text {
  font-size: 28rpx;
  color: #1A3C2A;
  font-weight: 600;
}

/* Content sections */
.content-section {
  margin-bottom: 50rpx;
}

.section-heading {
  font-size: 36rpx;
  font-weight: 800;
  color: #1A3C2A;
  padding-bottom: 16rpx;
  border-bottom: 4rpx solid #2D9A5D;
  margin-bottom: 24rpx;
}

.section-paragraph {
  font-size: 30rpx;
  color: #3A5D44;
  line-height: 2;
  margin-bottom: 20rpx;
  text-align: justify;
}

/* Key terms - green accent */
.key-terms {
  background: #F0F7F2;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 24rpx;
}

.key-terms-title {
  font-size: 26rpx;
  font-weight: 800;
  color: #2D9A5D;
  margin-bottom: 14rpx;
}

.term-item {
  margin-bottom: 12rpx;
  font-size: 26rpx;
  line-height: 1.7;
  padding: 8rpx 0;
}

.term-name {
  font-weight: 800;
  color: #1A3C2A;
}

.term-def {
  color: #5A7D66;
}

/* Quiz - green theme */
.quiz-section {
  margin-top: 50rpx;
  padding-top: 30rpx;
  border-top: 2rpx solid #D4E8DA;
}

.quiz-item {
  margin-bottom: 40rpx;
}

.quiz-question {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A3C2A;
  margin-bottom: 18rpx;
  line-height: 1.6;
}

.quiz-option {
  padding: 20rpx 28rpx;
  margin-bottom: 14rpx;
  border-radius: 16rpx;
  background: #F0F7F2;
  font-size: 28rpx;
  color: #3A5D44;
  border: 2rpx solid transparent;
  font-weight: 500;
}

.quiz-option.correct {
  background: #E8F5E9;
  border-color: #2D9A5D;
  color: #2D9A5D;
  font-weight: 700;
}

.quiz-option.wrong {
  background: #FCE4EC;
  border-color: #E74C3C;
  color: #E74C3C;
  font-weight: 700;
}

.quiz-explanation {
  padding: 20rpx 24rpx;
  background: #FFF8E1;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #F5A623;
  line-height: 1.7;
  margin-top: 14rpx;
  font-weight: 600;
}

/* Progress - green bar */
.progress-section {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 50rpx;
  padding-top: 30rpx;
  border-top: 2rpx solid #D4E8DA;
}

.progress-label {
  font-size: 26rpx;
  color: #6B8F7B;
  flex-shrink: 0;
  font-weight: 600;
}

.progress-bar-large {
  flex: 1;
  height: 14rpx;
  background: #D4E8DA;
  border-radius: 7rpx;
  overflow: hidden;
}

.progress-fill-large {
  height: 100%;
  background: #2D9A5D;
  border-radius: 7rpx;
  transition: width 0.3s ease;
}

.progress-percent {
  font-size: 26rpx;
  color: #2D9A5D;
  font-weight: 800;
  flex-shrink: 0;
}
