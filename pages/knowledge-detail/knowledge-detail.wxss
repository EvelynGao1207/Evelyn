.detail-meta-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.difficulty-badge {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.difficulty-badge.beginner {
  background: #e8f5e9;
  color: #2e7d32;
}

.difficulty-badge.intermediate {
  background: #fff3e0;
  color: #e65100;
}

.difficulty-badge.advanced {
  background: #fce4ec;
  color: #c62828;
}

.reading-time {
  font-size: 24rpx;
  color: #999;
}

.detail-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1a1a2e;
  line-height: 1.4;
  margin-bottom: 30rpx;
}

/* Table of contents */
.toc {
  background: #f8f7ff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 40rpx;
}

.toc-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #6c5ce7;
  margin-bottom: 16rpx;
}

.toc-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.toc-number {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #6c5ce7;
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.toc-text {
  font-size: 28rpx;
  color: #333;
}

/* Content sections */
.content-section {
  margin-bottom: 50rpx;
}

.section-heading {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a2e;
  padding-bottom: 16rpx;
  border-bottom: 4rpx solid #6c5ce7;
  margin-bottom: 24rpx;
}

.section-paragraph {
  font-size: 30rpx;
  color: #444;
  line-height: 2;
  margin-bottom: 20rpx;
  text-align: justify;
}

/* Key terms */
.key-terms {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-top: 20rpx;
}

.key-terms-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #6c5ce7;
  margin-bottom: 12rpx;
}

.term-item {
  margin-bottom: 10rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.term-name {
  font-weight: 700;
  color: #333;
}

.term-def {
  color: #666;
}

/* Quiz */
.quiz-section {
  margin-top: 50rpx;
  padding-top: 30rpx;
  border-top: 2rpx solid #eee;
}

.quiz-item {
  margin-bottom: 40rpx;
}

.quiz-question {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
  line-height: 1.6;
}

.quiz-option {
  padding: 18rpx 24rpx;
  margin-bottom: 12rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  font-size: 28rpx;
  color: #555;
  border: 2rpx solid transparent;
}

.quiz-option.correct {
  background: #e8f5e9;
  border-color: #4caf50;
  color: #2e7d32;
}

.quiz-option.wrong {
  background: #fce4ec;
  border-color: #f44336;
  color: #c62828;
}

.quiz-explanation {
  padding: 16rpx 20rpx;
  background: #fff8e1;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #f57f17;
  line-height: 1.7;
  margin-top: 12rpx;
}

/* Progress */
.progress-section {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 50rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid #eee;
}

.progress-label {
  font-size: 26rpx;
  color: #999;
  flex-shrink: 0;
}

.progress-bar-large {
  flex: 1;
  height: 12rpx;
  background: #e0e0e0;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill-large {
  height: 100%;
  background: linear-gradient(90deg, #6c5ce7, #a29bfe);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.progress-percent {
  font-size: 24rpx;
  color: #6c5ce7;
  font-weight: 600;
  flex-shrink: 0;
}
