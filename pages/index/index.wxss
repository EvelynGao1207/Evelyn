/* Header - bold & playful */
.header {
  padding: 20rpx 0 24rpx;
}

.header-title {
  font-size: 56rpx;
  font-weight: 900;
  color: #1A3C2A;
  letter-spacing: 2rpx;
}

.header-subtitle {
  font-size: 26rpx;
  color: #6B8F7B;
  margin-top: 8rpx;
  font-weight: 500;
}

.header-date {
  font-size: 24rpx;
  color: #A0C4AD;
  margin-top: 6rpx;
  font-weight: 600;
}

/* Category scroll - pill buttons */
.category-scroll {
  white-space: nowrap;
  margin-bottom: 28rpx;
}

.category-list {
  display: inline-flex;
  gap: 16rpx;
  padding: 10rpx 0;
}

.category-item {
  display: inline-block;
  padding: 14rpx 32rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: 600;
  background: #fff;
  color: #6B8F7B;
  border: 2rpx solid #D4E8DA;
  transition: all 0.3s;
}

.category-item.active {
  background: #2D9A5D;
  color: #fff;
  border-color: #2D9A5D;
  box-shadow: 0 4rpx 16rpx rgba(45, 154, 93, 0.3);
}

/* News card - rounded & clean */
.news-card {
  position: relative;
  border-left: 6rpx solid #2D9A5D;
}

.news-card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.news-source {
  font-size: 24rpx;
  color: #2D9A5D;
  font-weight: 700;
  background: #E8F5E9;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}

.news-time {
  font-size: 22rpx;
  color: #A0C4AD;
  font-weight: 500;
}

.news-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1A3C2A;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.news-summary {
  font-size: 26rpx;
  color: #5A7D66;
  line-height: 1.8;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 18rpx;
}

.news-card-bottom {
  display: flex;
  align-items: center;
}

.news-translate-btn {
  margin-left: auto;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #2D9A5D;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(45, 154, 93, 0.3);
}

.news-translated-hint {
  margin-left: auto;
  font-size: 22rpx;
  color: #2D9A5D;
  font-weight: 600;
  background: #E8F5E9;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}

/* Translated block - green accent */
.translated-block {
  margin-top: 20rpx;
  padding: 24rpx;
  background: #F0F7F2;
  border-radius: 16rpx;
  border-left: 6rpx solid #2D9A5D;
}

.translated-label {
  font-size: 22rpx;
  color: #2D9A5D;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.translated-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #1A3C2A;
  margin-bottom: 8rpx;
}

.translated-summary {
  font-size: 26rpx;
  color: #5A7D66;
  line-height: 1.8;
}

/* Load more - green pill */
.load-more {
  text-align: center;
  padding: 30rpx 0;
}

.load-more-text {
  display: inline-block;
  color: #2D9A5D;
  font-size: 28rpx;
  font-weight: 700;
  background: #E8F5E9;
  padding: 14rpx 48rpx;
  border-radius: 40rpx;
}
