/* Header */
.header {
  padding: 20rpx 0 24rpx;
}

.header-title {
  font-size: 52rpx;
  font-weight: 900;
  color: #1A3C2A;
}

.header-subtitle {
  font-size: 26rpx;
  color: #6B8F7B;
  margin-top: 8rpx;
  font-weight: 500;
}

/* Search - rounded pill */
.search-bar {
  margin-bottom: 32rpx;
}

.search-input {
  background: #fff;
  border-radius: 40rpx;
  padding: 22rpx 32rpx;
  font-size: 28rpx;
  border: 2rpx solid #D4E8DA;
  color: #2C3E2D;
  box-shadow: 0 2rpx 12rpx rgba(45, 154, 93, 0.06);
}

/* Category cards - vibrant colored left borders */
.knowledge-category-card {
  display: flex;
  align-items: center;
  padding: 28rpx;
  border-left: 6rpx solid #2D9A5D;
}

.kc-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.kc-info {
  flex: 1;
}

.kc-name {
  font-size: 32rpx;
  font-weight: 800;
  color: #1A3C2A;
  margin-bottom: 6rpx;
}

.kc-desc {
  font-size: 24rpx;
  color: #6B8F7B;
  margin-bottom: 8rpx;
}

.kc-count {
  font-size: 22rpx;
  color: #2D9A5D;
  font-weight: 700;
  background: #E8F5E9;
  display: inline-block;
  padding: 2rpx 14rpx;
  border-radius: 12rpx;
}

.kc-arrow {
  color: #A0C4AD;
  font-size: 36rpx;
  margin-left: 16rpx;
  font-weight: 700;
}

/* Article list */
.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.list-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #1A3C2A;
}

.list-back {
  font-size: 26rpx;
  color: #2D9A5D;
  font-weight: 700;
  background: #E8F5E9;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
}

.knowledge-article {
  padding: 28rpx;
}

.ka-difficulty {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #6B8F7B;
  margin-bottom: 12rpx;
  font-weight: 600;
}

.difficulty-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}

.difficulty-dot.beginner {
  background: #2D9A5D;
}

.difficulty-dot.intermediate {
  background: #F5A623;
}

.difficulty-dot.advanced {
  background: #E74C3C;
}

.ka-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1A3C2A;
  margin-bottom: 10rpx;
  line-height: 1.5;
}

.ka-preview {
  font-size: 26rpx;
  color: #5A7D66;
  line-height: 1.7;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.ka-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.ka-reading-time {
  font-size: 22rpx;
  color: #A0C4AD;
  font-weight: 600;
}

.ka-progress {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.progress-bar {
  width: 100rpx;
  height: 10rpx;
  background: #D4E8DA;
  border-radius: 5rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #2D9A5D;
  border-radius: 5rpx;
}

.progress-text {
  font-size: 20rpx;
  color: #2D9A5D;
  font-weight: 700;
}
