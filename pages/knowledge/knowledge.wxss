.header {
  padding: 30rpx 0 20rpx;
}

.header-title {
  font-size: 48rpx;
  font-weight: 800;
  color: #1a1a2e;
}

.header-subtitle {
  font-size: 26rpx;
  color: #666;
  margin-top: 8rpx;
}

/* Search */
.search-bar {
  margin-bottom: 30rpx;
}

.search-input {
  background: #fff;
  border-radius: 40rpx;
  padding: 20rpx 30rpx;
  font-size: 28rpx;
  border: 1rpx solid #e0e0e0;
}

/* Category cards */
.knowledge-category-card {
  display: flex;
  align-items: center;
  padding: 28rpx;
}

.kc-icon {
  width: 90rpx;
  height: 90rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.kc-info {
  flex: 1;
}

.kc-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 6rpx;
}

.kc-desc {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 6rpx;
}

.kc-count {
  font-size: 22rpx;
  color: #6c5ce7;
}

.kc-arrow {
  color: #ccc;
  font-size: 32rpx;
  margin-left: 16rpx;
}

/* Article list */
.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.list-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.list-back {
  font-size: 26rpx;
  color: #6c5ce7;
}

.knowledge-article {
  padding: 24rpx 28rpx;
}

.ka-difficulty {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #888;
  margin-bottom: 10rpx;
}

.difficulty-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}

.difficulty-dot.beginner {
  background: #4caf50;
}

.difficulty-dot.intermediate {
  background: #ff9800;
}

.difficulty-dot.advanced {
  background: #f44336;
}

.ka-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 10rpx;
  line-height: 1.4;
}

.ka-preview {
  font-size: 26rpx;
  color: #777;
  line-height: 1.6;
  margin-bottom: 14rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.ka-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.ka-reading-time {
  font-size: 22rpx;
  color: #aaa;
}

.ka-progress {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.progress-bar {
  width: 100rpx;
  height: 8rpx;
  background: #e0e0e0;
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #6c5ce7;
  border-radius: 4rpx;
}

.progress-text {
  font-size: 20rpx;
  color: #6c5ce7;
}
