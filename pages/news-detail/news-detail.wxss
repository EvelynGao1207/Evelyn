/* Detail meta */
.detail-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.detail-source {
  font-size: 26rpx;
  color: #2D9A5D;
  font-weight: 700;
  background: #E8F5E9;
  padding: 6rpx 18rpx;
  border-radius: 16rpx;
}

.detail-time {
  font-size: 24rpx;
  color: #A0C4AD;
  font-weight: 500;
}

.detail-title {
  font-size: 40rpx;
  font-weight: 900;
  color: #1A3C2A;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.detail-translated-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #2D9A5D;
  line-height: 1.5;
  margin-bottom: 20rpx;
  padding: 20rpx;
  background: #F0F7F2;
  border-radius: 16rpx;
  border-left: 6rpx solid #2D9A5D;
}

.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

/* Translate bar - green pill */
.translate-bar {
  margin-bottom: 32rpx;
}

.translate-btn {
  display: inline-block;
  padding: 16rpx 40rpx;
  border-radius: 40rpx;
  background: #2D9A5D;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(45, 154, 93, 0.3);
}

.translate-btn.translated {
  background: #F0F7F2;
  color: #2D9A5D;
  box-shadow: none;
  border: 2rpx solid #D4E8DA;
}

.translate-hint {
  display: inline-block;
  margin-left: 20rpx;
  font-size: 22rpx;
  color: #A0C4AD;
  font-weight: 500;
  line-height: 60rpx;
  vertical-align: middle;
}

/* Content */
.content-paragraph {
  font-size: 30rpx;
  color: #3A5D44;
  line-height: 2;
  margin-bottom: 24rpx;
  text-align: justify;
}

.content-paragraph.has-translation {
  color: #1A3C2A;
  font-weight: 600;
}

/* Inline translation */
.inline-translation {
  background: #F0F7F2;
  border-left: 4rpx solid #2D9A5D;
  border-radius: 0 12rpx 12rpx 0;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
  margin-top: -12rpx;
}

.inline-translation-text {
  font-size: 28rpx;
  color: #2D9A5D;
  line-height: 1.8;
  font-weight: 500;
}

/* Key findings */
.key-findings {
  margin-top: 40rpx;
  padding-top: 30rpx;
  border-top: 2rpx solid #D4E8DA;
}

.finding-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 18rpx;
  padding: 16rpx;
  background: #F0F7F2;
  border-radius: 16rpx;
}

.finding-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #2D9A5D;
  margin-top: 14rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.finding-text {
  font-size: 28rpx;
  color: #3A5D44;
  line-height: 1.7;
  font-weight: 500;
}

/* Original link */
.original-link {
  margin-top: 40rpx;
  padding: 24rpx;
  background: #F0F7F2;
  border-radius: 16rpx;
}

.link-label {
  font-size: 24rpx;
  color: #A0C4AD;
  margin-bottom: 8rpx;
  font-weight: 600;
}

.link-url {
  font-size: 24rpx;
  color: #2D9A5D;
  word-break: break-all;
  font-weight: 600;
}
