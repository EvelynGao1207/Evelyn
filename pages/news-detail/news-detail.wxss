.detail-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.detail-source {
  font-size: 26rpx;
  color: #6c5ce7;
  font-weight: 600;
}

.detail-time {
  font-size: 24rpx;
  color: #aaa;
}

.detail-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #1a1a2e;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.detail-translated-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #6c5ce7;
  line-height: 1.5;
  margin-bottom: 16rpx;
  padding: 16rpx;
  background: #f8f7ff;
  border-radius: 12rpx;
}

.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

/* Translate bar */
.translate-bar {
  margin-bottom: 30rpx;
}

.translate-btn {
  display: inline-block;
  padding: 14rpx 36rpx;
  border-radius: 30rpx;
  background: #6c5ce7;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
}

.translate-btn.translated {
  background: #e8f5e9;
  color: #2e7d32;
}

/* Content */
.content-paragraph {
  font-size: 30rpx;
  color: #444;
  line-height: 2;
  margin-bottom: 24rpx;
  text-align: justify;
}

/* Key findings */
.key-findings {
  margin-top: 40rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid #eee;
}

.finding-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.finding-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #6c5ce7;
  margin-top: 16rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.finding-text {
  font-size: 28rpx;
  color: #555;
  line-height: 1.7;
}

/* Original link */
.original-link {
  margin-top: 40rpx;
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
}

.link-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.link-url {
  font-size: 24rpx;
  color: #6c5ce7;
  word-break: break-all;
}
